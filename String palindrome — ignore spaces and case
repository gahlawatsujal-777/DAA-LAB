#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[200], clean[200];
    int i, j = 0, left, right, palindrome = 1;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] != ' ') {
            clean[j++] = tolower(str[i]);
        }
    }

    clean[j] = '\0';

    left = 0;
    right = j - 1;

    while (left < right) {
        if (clean[left] != clean[right]) {
            palindrome = 0;
            break;
        }

        left++;
        right--;
    }

    if (palindrome)
        printf("Palindrome");
    else
        printf("Not a palindrome");

    return 0;
}
