#include <stdio.h>

int main() {
    int a[] = {2, 7, 4, 5, 1, 3};
    int n = 6;
    int target = 6;
    int i, j;

    printf("Pairs with sum %d:\n", target);

    for (i = 0; i < n; i++) {
        for (j = i + 1; j < n; j++) {
            if (a[i] + a[j] == target)
                printf("(%d, %d)\n", a[i], a[j]);
        }
    }

    return 0;
}
