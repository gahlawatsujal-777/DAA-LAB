#include <stdio.h>

void reverse(int a[], int start, int end) {
    int temp;

    while (start < end) {
        temp = a[start];
        a[start] = a[end];
        a[end] = temp;

        start++;
        end--;
    }
}

int main() {
    int a[] = {1, 2, 3, 4, 5, 6};
    int n = 6;
    int k = 2;
    int i;

    k = k % n;

    reverse(a, 0, n - 1);
    reverse(a, 0, k - 1);
    reverse(a, k, n - 1);

    printf("Rotated array:\n");

    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
