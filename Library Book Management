#include <stdio.h>
#include <string.h>

struct Book {
    int id;
    char title[100];
    char author[100];
    int total;
    int available;
};

int main() {
    struct Book books[100];
    int count = 0;
    int choice, id, i, found;

    do {
        printf("\n\n--- LIBRARY MENU ---\n");
        printf("1. Add Book\n");
        printf("2. Search Book\n");
        printf("3. Issue Book\n");
        printf("4. Return Book\n");
        printf("5. Display Unavailable Books\n");
        printf("6. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1:
            printf("Enter book ID: ");
            scanf("%d", &books[count].id);

            printf("Enter title: ");
            scanf(" %[^\n]", books[count].title);

            printf("Enter author: ");
            scanf(" %[^\n]", books[count].author);

            printf("Enter total copies: ");
            scanf("%d", &books[count].total);

            books[count].available = books[count].total;

            count++;

            printf("Book added successfully.");
            break;

        case 2:
            printf("Enter book ID: ");
            scanf("%d", &id);

            found = 0;

            for (i = 0; i < count; i++) {
                if (books[i].id == id) {
                    printf("\nID: %d", books[i].id);
                    printf("\nTitle: %s", books[i].title);
                    printf("\nAuthor: %s", books[i].author);
                    printf("\nAvailable: %d", books[i].available);
                    found = 1;
                    break;
                }
            }

            if (!found)
                printf("Book not found.");

            break;

        case 3:
            printf("Enter book ID: ");
            scanf("%d", &id);

            found = 0;

            for (i = 0; i < count; i++) {
                if (books[i].id == id) {
                    found = 1;

                    if (books[i].available > 0) {
                        books[i].available--;
                        printf("Book issued.");
                    }
                    else {
                        printf("Book is unavailable.");
                    }

                    break;
                }
            }

            if (!found)
                printf("Book not found.");

            break;

        case 4:
            printf("Enter book ID: ");
            scanf("%d", &id);

            found = 0;

            for (i = 0; i < count; i++) {
                if (books[i].id == id) {
                    found = 1;

                    if (books[i].available < books[i].total) {
                        books[i].available++;
                        printf("Book returned.");
                    }
                    else {
                        printf("All copies are already available.");
                    }

                    break;
                }
            }

            if (!found)
                printf("Book not found.");

            break;

        case 5:
            printf("\n--- UNAVAILABLE BOOKS ---\n");

            for (i = 0; i < count; i++) {
                if (books[i].available == 0) {
                    printf("ID: %d | Title: %s\n",
                           books[i].id, books[i].title);
                }
            }

            break;

        case 6:
            printf("Exiting...");
            break;

        default:
            printf("Invalid choice.");
        }

    } while (choice != 6);

    return 0;
}
