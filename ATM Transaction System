#include <stdio.h>

int main() {
    float balance = 1000.0;
    float amount;
    float transactions[5];
    int count = 0;
    int choice, i;

    do {
        printf("\n\n--- ATM MENU ---\n");
        printf("1. Check Balance\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Display Last 5 Transactions\n");
        printf("5. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1:
            printf("Balance = %.2f\n", balance);
            break;

        case 2:
            printf("Enter deposit amount: ");
            scanf("%f", &amount);

            if (amount > 0) {
                balance += amount;

                if (count < 5)
                    transactions[count++] = amount;
                else {
                    for (i = 0; i < 4; i++)
                        transactions[i] = transactions[i + 1];

                    transactions[4] = amount;
                }

                printf("Amount deposited successfully.");
            }
            else {
                printf("Invalid amount.");
            }

            break;

        case 3:
            printf("Enter withdrawal amount: ");
            scanf("%f", &amount);

            if (amount <= 0) {
                printf("Invalid amount.");
            }
            else if (amount > balance) {
                printf("Insufficient balance.");
            }
            else {
                balance -= amount;

                if (count < 5)
                    transactions[count++] = -amount;
                else {
                    for (i = 0; i < 4; i++)
                        transactions[i] = transactions[i + 1];

                    transactions[4] = -amount;
                }

                printf("Please collect your money.");
            }

            break;

        case 4:
            printf("\n--- LAST 5 TRANSACTIONS ---\n");

            for (i = 0; i < count; i++) {
                if (transactions[i] > 0)
                    printf("Deposit: +%.2f\n", transactions[i]);
                else
                    printf("Withdrawal: %.2f\n", transactions[i]);
            }

            break;

        case 5:
            printf("Thank you!");
            break;

        default:
            printf("Invalid choice.");
        }

    } while (choice != 5);

    return 0;
}
